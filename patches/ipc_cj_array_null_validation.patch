+    if (value.len > 0 && value.data == nullptr) {
+        return errorDesc::WRITE_DATA_TO_MESSAGE_SEQUENCE_ERROR;
+    }
     if (CheckWriteCapacity(BYTE_SIZE_8 * (value.len + 1))) {
